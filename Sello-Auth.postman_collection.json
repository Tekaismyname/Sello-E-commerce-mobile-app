            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"{{customerIdentifier}}\",\n  \"targetValue\": \"{{resetTargetValue}}\",\n  \"otpCode\": \"{{resetOtp}}\",\n  \"newPassword\": \"{{customerNewPassword}}\",\n  \"confirmNewPassword\": \"{{customerNewPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/reset-password",
              "host": [
                "{{baseUrl}}"
              ],
