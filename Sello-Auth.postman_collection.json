  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            ""
          ]
        }
      },
      "response": []
    },
    {
      "name": "Home Page",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/home",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "home"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Register Flow",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const method = pm.collectionVariables.get('registerDeliveryMethod');",
                  "const email = pm.collectionVariables.get('registerEmail');",
                  "const phone = pm.collectionVariables.get('registerPhone');",
                  "pm.collectionVariables.set('registerVerifyTargetValue', method === 'phone' ? phone : email);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const data = pm.response.json();",
                  "  if (data.user && data.user.id) {",
                  "    pm.collectionVariables.set('registeredUserId', String(data.user.id));",
                  "  }",
                  "  if (data.otp && data.otp.otpCodePreview) {",
                  "    pm.collectionVariables.set('registerOtp', data.otp.otpCodePreview);",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Test User\",\n  \"email\": \"{{registerEmail}}\",\n  \"phone\": \"{{registerPhone}}\",\n  \"password\": \"Password123\",\n  \"confirmPassword\": \"Password123\",\n  \"deliveryMethod\": \"{{registerDeliveryMethod}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Verify Register OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"targetValue\": \"{{registerVerifyTargetValue}}\",\n  \"purpose\": \"register\",\n  \"otpCode\": \"{{registerOtp}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/verify-otp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "verify-otp"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Delete Registered User",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/users/{{registeredUserId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "users",
                "{{registeredUserId}}"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Login Flow",
      "item": [
        {
          "name": "Login Customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const data = pm.response.json();",
                  "  if (data.tokens) {",
                  "    pm.collectionVariables.set('accessToken', data.tokens.accessToken || '');",
                  "    pm.collectionVariables.set('refreshToken', data.tokens.refreshToken || '');",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"{{customerIdentifier}}\",\n  \"password\": \"{{customerPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          },
          "response": []
        },
