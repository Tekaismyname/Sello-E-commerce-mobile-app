    "name": "Sello Auth API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Postman collection for testing Sello Ecommerce auth flows with MySQL-backed users, OTP delivery by email or phone, and logout."
